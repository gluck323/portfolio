---
import { site } from '../data/site';
import Icon from './Icon.astro';
const year = 2026; // ビルド時固定（Date.nowは使わない方針）
---
<footer class="border-t border-rule">
  <div class="shell flex flex-col gap-8 py-16 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="font-display text-2xl text-ink">{site.name}<span class="text-accent">.</span></p>
      <p class="label mt-3">{site.intro}</p>
    </div>

    <ul class="flex flex-wrap items-center gap-x-5 gap-y-3">
      {site.socials.map((s) => (
        <li>
          <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label} title={s.label} class="block text-ink/55 transition-colors hover:text-accent">
            <Icon name={s.label} size={20} />
          </a>
        </li>
      ))}
      <li>
        <a href={`mailto:${site.email}`} aria-label="Email" title="Email" class="block text-ink/55 transition-colors hover:text-accent">
          <Icon name="mail" size={20} />
        </a>
      </li>
    </ul>
  </div>
  <div class="shell pb-10">
    <p class="label">© {year} {site.name}. Built with Astro.</p>
  </div>
</footer>
