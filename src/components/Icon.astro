---
// SNS/連絡先のアイコン。currentColor を継承するモノクロSVG。
// name は SNS の label（github / x / note）または 'mail'。
interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 18, class: className = '' } = Astro.props;
const key = name.trim().toLowerCase();
const common = {
  width: size,
  height: size,
  viewBox: '0 0 24 24',
  'aria-hidden': 'true',
  class: className,
};
---
{key === 'github' && (
  <svg {...common} fill="currentColor">
    <path d="M12 .5C5.73.5.5 5.74.5 12.02c0 5.1 3.29 9.42 7.86 10.95.58.1.79-.25.79-.56v-1.96c-3.2.7-3.87-1.54-3.87-1.54-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.17.09 1.78 1.21 1.78 1.21 1.03 1.78 2.71 1.26 3.37.97.1-.75.4-1.27.73-1.56-2.56-.29-5.25-1.28-5.25-5.71 0-1.26.45-2.3 1.19-3.11-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.19a11 11 0 0 1 5.79 0c2.2-1.5 3.17-1.19 3.17-1.19.63 1.59.23 2.76.12 3.05.74.81 1.18 1.85 1.18 3.11 0 4.44-2.7 5.42-5.27 5.7.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.53 11.53 0 0 0 23.5 12.02C23.5 5.74 18.27.5 12 .5Z" />
  </svg>
)}
{key === 'x' && (
  <svg {...common} fill="currentColor">
    <path d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.65l-5.21-6.81-5.96 6.81H1.7l7.73-8.84L1.25 2.25h6.82l4.71 6.23 5.46-6.23Zm-1.16 17.52h1.83L7.01 4.13H5.04l12.04 15.64Z" />
  </svg>
)}
{key === 'note' && (
  <svg {...common} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
    <rect x="3.25" y="3.25" width="17.5" height="17.5" rx="4" />
    <path d="M7.5 8.75h9M7.5 12h9M7.5 15.25h5.5" />
  </svg>
)}
{(key === 'mail' || key === 'email') && (
  <svg {...common} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
    <rect x="3" y="5" width="18" height="14" rx="2" />
    <path d="m3.5 6.5 8.5 6.5 8.5-6.5" stroke-linecap="round" />
  </svg>
)}
{!['github', 'x', 'note', 'mail', 'email'].includes(key) && (
  <svg {...common} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
    <path d="M9 15 15 9M10 7h6a1 1 0 0 1 1 1v6M7.5 16.5 16.5 7.5" />
  </svg>
)}
