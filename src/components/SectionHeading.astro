---
interface Props {
  label: string; // 例: "01 — Selected Work"
  title?: string; // 大きなセリフ見出し
  meta?: string; // 右側の小さなメタ（年など）
}
const { label, title, meta } = Astro.props;
---
<div class="mb-12 flex items-end justify-between gap-6 border-t border-rule pt-6">
  <div>
    <p class="label">{label}</p>
    {title && <h2 class="mt-3 text-3xl md:text-5xl">{title}</h2>}
  </div>
  {meta && <p class="label shrink-0 whitespace-nowrap">{meta}</p>}
</div>
