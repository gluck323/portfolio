---
import { site } from '../data/site';
const paragraphs = (site.aboutBody ?? '')
  .split(/\n{2,}/)
  .map((s) => s.trim())
  .filter(Boolean);
---
<div class="grid grid-cols-12 gap-x-8 gap-y-12 md:items-start">
  <!-- 写真 -->
  {site.avatar && (
    <figure class="col-span-7 sm:col-span-5 md:col-span-4">
      <img
        src={site.avatar}
        alt={site.name}
        width="640"
        height="640"
        loading="lazy"
        class="w-full border border-rule object-cover"
        style="aspect-ratio: 1 / 1; border-radius: 2px;"
      />
    </figure>
  )}

  <!-- 名前 + 自己紹介 / 経歴 -->
  <div class={`col-span-12 ${site.avatar ? 'md:col-span-7 md:col-start-6' : 'md:col-span-8'}`}>
    <h3 class="font-display text-3xl leading-tight md:text-[2.5rem]">{site.aboutLead}</h3>
    <div class="measure mt-6 space-y-4 text-lg text-muted">
      {paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </div>

  <!-- メタ帯（全幅・上に罫線で余白を締める） -->
  <div class="col-span-12 mt-2 grid grid-cols-12 gap-x-8 gap-y-10 border-t border-rule pt-10">
    {site.tools.length > 0 && (
      <div class="col-span-12 md:col-span-7">
        <p class="label">Tools</p>
        <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-muted">
          {site.tools.map((t) => <li>{t}</li>)}
        </ul>
      </div>
    )}
    <div class={`col-span-12 ${site.tools.length > 0 ? 'md:col-span-5' : 'md:col-span-12'}`}>
      <p class="label">Elsewhere</p>
      <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
        {site.socials.map((s) => (
          <li><a href={s.href} target="_blank" rel="noopener noreferrer" class="label link hover:text-ink">{s.label}</a></li>
        ))}
        <li><a href={`mailto:${site.email}`} class="label link hover:text-ink">Email</a></li>
      </ul>
    </div>
  </div>
</div>
