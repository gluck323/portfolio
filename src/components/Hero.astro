---
import { site } from '../data/site';
const lines = site.tagline.split('\n');
---
<section class="shell pt-20 pb-24 md:pt-32 md:pb-36">
  <p class="label">Portfolio</p>

  <h1
    class="mt-6 max-w-[14ch] font-display font-normal tracking-[-0.02em] text-ink"
    style="font-size: clamp(2.75rem, 8vw, 6.5rem); line-height: 1.04;"
  >
    {lines.map((line, i) => (
      <span class="block">{i === lines.length - 1 ? <>{line}<span class="text-accent">.</span></> : line}</span>
    ))}
  </h1>

  <p class="measure mt-8 text-lg text-muted md:text-xl">{site.intro}</p>

  <div class="mt-10 flex flex-wrap items-center gap-4">
    <a href="#work" class="btn">Selected Work</a>
    <a href="#contact" class="label link hover:text-ink">Get in touch</a>
  </div>
</section>
